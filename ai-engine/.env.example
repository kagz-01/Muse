# Muse AI Engine - Production Configuration

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
# Options: development, staging, production

# ============================================================================
# NLP ENGINE CONFIGURATION
# ============================================================================

# NLP Engine Type
# - local: Fast local NLP (spaCy + sklearn + TextBlob). Free, instant, ~100ms
# - groq_enriched: Local NLP + Groq LLM enrichment. Faster+diverse, requires Groq API
NLP_ENGINE_TYPE=groq_enriched

# Groq API Key (required if using groq_enriched)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# NLP Caching
# TTL in minutes for cached NLP results (same text analyzed multiple times)
NLP_CACHE_TTL_MINUTES=60

# Max cache size (number of unique analyses to cache)
NLP_MAX_CACHE_SIZE=1000

# Enable/disable NLP components
NLP_ENABLE_SPACY=true
NLP_ENABLE_TEXTBLOB=true

# Max text length to analyze (longer texts truncated)
NLP_MAX_TEXT_LENGTH=10000

# ============================================================================
# SYNTHESIS ENGINE CONFIGURATION
# ============================================================================

# Main LLM Model for synthesis
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
SYNTHESIS_MODEL=gpt-4o

# OpenAI API Key (required)
OPENAI_API_KEY=sk_your_openai_api_key_here

# Temperature (0.0 = deterministic, 1.0 = creative)
SYNTHESIS_TEMPERATURE=0.4

# Max tokens for synthesis response
SYNTHESIS_MAX_TOKENS=1000

# Synthesis timeout in seconds
SYNTHESIS_TIMEOUT_SECONDS=30

# Use Groq for synthesis instead of OpenAI (experimental)
SYNTHESIS_USE_GROQ=false

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Enable metrics collection
ENABLE_METRICS=true

# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/muse_db

# Connection pooling
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Echo SQL queries (debug mode)
DATABASE_ECHO=false

# ============================================================================
# SCRAPER CONFIGURATION (Optional)
# ============================================================================

# YouTube scraper (no API key needed)
YOUTUBE_TRANSCRIPT_LANGUAGES=en

# Social media scraper timeout (seconds)
SOCIAL_MEDIA_TIMEOUT=15

# Web scraper user agent
WEB_SCRAPER_USER_AGENT=Muse-AI-Engine/2.0

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable sentiment analysis in streak sparks
ENABLE_SENTIMENT_IN_SPARKS=true

# Enable theme extraction for artifacts
ENABLE_THEME_EXTRACTION=true

# Enable confidence scoring in analysis results
ENABLE_CONFIDENCE_SCORES=true

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# Sentry error tracking (optional)
SENTRY_DSN=

# Datadog metrics (optional)
DATADOG_API_KEY=

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Number of worker processes
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Max concurrent synthesis operations
MAX_CONCURRENT_SYNTHESIS=5

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================

# 1. LOCAL DEVELOPMENT
#    - Use local NLP engine (free, no API keys needed)
#    - Copy this file to .env
#    - Run: pip install -r requirements.txt
#    - Run: python -m spacy download en_core_web_sm
#    - Run: python -m textblob.download_corpora
#    - Start: uvicorn main:app --reload

# 2. GROQ API ENRICHMENT (RECOMMENDED)
#    - Sign up for Groq: https://console.groq.com
#    - Copy your API key to GROQ_API_KEY
#    - Models available: mixtral-8x7b-32768, llama2-70b-4096, etc.
#    - Groq is FREE and 10x faster than OpenAI

# 3. PRODUCTION DEPLOYMENT
#    - Set ENVIRONMENT=production
#    - Use strong passwords for database
#    - Enable ENABLE_METRICS=true for monitoring
#    - Set LOG_LEVEL=WARNING to reduce log volume
#    - Configure SENTRY_DSN for error tracking
#    - Run with: gunicorn main:app --workers 4

# 4. DOCKER DEPLOYMENT
#    - Build: docker build -t muse-ai-engine .
#    - Run: docker run -e GROQ_API_KEY=$GROQ_API_KEY -e OPENAI_API_KEY=$OPENAI_API_KEY muse-ai-engine

# 5. GROQ vs LOCAL NLP
#    LOCAL NLP (Default):
#    - Cost: $0
#    - Speed: <100ms
#    - Accuracy: Good for basic analysis
#    - No external dependencies
#
#    GROQ ENRICHED:
#    - Cost: $0 (Groq API is free)
#    - Speed: <500ms (Groq + local combined)
#    - Accuracy: Excellent (LLM-backed)
#    - More diverse theme extraction
#    - Recommended for production

# ============================================================================
