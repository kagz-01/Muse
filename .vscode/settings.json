{
  "deno.enable": true,
  "deno.lint": true,
  "editor.defaultFormatter": "denoland.vscode-deno",
  "[typescriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[javascript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "css.customData": [
    ".vscode/tailwind.json"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/ai-engine/venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/ai-engine"
  ],
  "python.analysis.autoSearchPaths": true,
  "python.analysis.useImportHeuristic": true,
  "deno.enable": true,
  "deno.unstable": true,
  "deno.config": "${workspaceFolder}/frontend-gateway/deno.json",
  "deno.enablePaths": ["${workspaceFolder}/frontend-gateway"]
}
